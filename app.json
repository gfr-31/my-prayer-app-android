{
  "expo": {
    "name": "My Prayer App Android",
    "slug": "MyPrayerApp-Android",
    "version": "1.3.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-logo.png",
        "backgroundColor": "#0F5132"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gifran.MyPrayerAppAndroid",
      "versionCode": 4
    },
    "web": {},
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6000841c-3a20-41d4-86b9-7302c83ceed3"
      },
      "cli": {
        "appVersionSource": "remote"
      }
    }
  }
}
